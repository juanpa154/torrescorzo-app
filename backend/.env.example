# ── Base de datos local (Prisma) ──────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/torrescorzo_local

# ── Autenticación ─────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_valor_de_64_caracteres_hex

# ── BD remota vencimientos ────────────────────────────────────────────────────
TU_HOST_REMOTO=192.168.1.50
TU_USUARIO=usuario_bd
TU_PASSWORD=contraseña_bd
NOMBRE_DE_LA_BD=nombre_bd_vencimientos

# ── BD remota CFDI ────────────────────────────────────────────────────────────
PG_CFDI_HOST=192.168.1.51
PG_CFDI_PORT=5432
PG_CFDI_USER=usuario_cfdi
PG_CFDI_PASSWORD=contraseña_cfdi
PG_CFDI_DB=nombre_bd_cfdi

# ── OpenAI (clasificador IA) ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development   # development | production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Vacío = abierto (solo dev). En producción, URL(s) del frontend separadas por coma.
CORS_ORIGIN=https://siia-cloud.vercel.app

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info         # trace | debug | info | warn | error | fatal

# ── Cron de sincronización CFDI ───────────────────────────────────────────────
CFDI_CRON_ENABLED=true
CFDI_CRON_SCHEDULE=0 2 * * *   # cada día a las 2am (formato cron estándar)
