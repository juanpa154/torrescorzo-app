generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"  // ✅ Recomendado
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
  role     String   @default("viewer")
  createdAt DateTime @default(now())

  announcements Announcement[]
}


model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
}

model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  position  String
  location  String?
  agency    String
  createdAt DateTime @default(now())
}

model Agency {
  id    Int    @id @default(autoincrement())
  name  String @unique
}

model Location {
  id    Int    @id @default(autoincrement())
  name  String @unique
}

model CfdiEmitido {
  id             Int       @id @default(autoincrement())
  uuid           String
  schema         String
  fechaEmision   DateTime?
  tipo           String?
  rfcReceptor    String?
  rfcEmisor      String?
  subtotal       Decimal?  @db.Decimal(18, 2)
  iva16          Decimal?  @db.Decimal(18, 2)
  totalRetenidos Decimal?  @db.Decimal(18, 2)
  total          Decimal?  @db.Decimal(18, 2)
  conceptos      String?
  categoriaIa    String?
  datos          Json
  sincronizadoAt DateTime  @default(now())

  @@unique([uuid, schema])
  @@index([schema, fechaEmision])
  @@index([schema, tipo])
  @@index([schema, categoriaIa])
  @@map("cfdi_emitidos")
}

model CfdiRecibido {
  id             Int       @id @default(autoincrement())
  uuid           String
  schema         String
  fechaEmision   DateTime?
  tipo           String?
  rfcEmisor      String?
  rfcReceptor    String?
  subtotal       Decimal?  @db.Decimal(18, 2)
  iva16          Decimal?  @db.Decimal(18, 2)
  totalRetenidos Decimal?  @db.Decimal(18, 2)
  total          Decimal?  @db.Decimal(18, 2)
  conceptos      String?
  categoriaIa    String?
  datos          Json
  sincronizadoAt DateTime  @default(now())

  @@unique([uuid, schema])
  @@index([schema, fechaEmision])
  @@index([schema, tipo])
  @@index([schema, categoriaIa])
  @@map("cfdi_recibidos")
}

model SyncEstado {
  id                 Int       @id @default(autoincrement())
  schema             String
  tipoCfdi           String
  ultimaSync         DateTime?
  totalSincronizados Int       @default(0)
  enProgreso         Boolean   @default(false)

  @@unique([schema, tipoCfdi])
  @@map("sync_estados")
}

